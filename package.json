{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",

    "test:ci": "playwright test --project=chromium --project=firefox --project=api --grep-invert @knownIssue",

    "test:ci:smoke": "playwright test --project=chromium --project=firefox --project=api --grep @smoke --grep-invert @knownIssue",

    "test:ci:regression": "playwright test --project=chromium --project=firefox --project=api --grep @regression --grep-invert @knownIssue",

    "test:ci:ui": "playwright test tests/ui --project=chromium --project=firefox --grep-invert @knownIssue",

    "test:ci:api": "playwright test tests/api --project=api --grep-invert @knownIssue",

    "test:ci:qa": "cross-env ENV=qa npm run test:ci",
    "test:ci:dev": "cross-env ENV=dev npm run test:ci",
    "test:ci:prod": "cross-env ENV=prod npm run test:ci",

    "test:known-issues": "playwright test --grep @knownIssue",

    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",

    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",

    "test:ui:smoke": "playwright test tests/ui --grep @smoke",
    "test:ui:regression": "playwright test tests/ui --grep @regression",

    "test:api:smoke": "playwright test tests/api --grep @smoke",
    "test:api:regression": "playwright test tests/api --grep @regression",

    "test:headed": "playwright test --headed",

    "test:qa": "cross-env ENV=qa playwright test",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:prod": "cross-env ENV=prod playwright test",

    "report": "playwright show-report",

    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QA-abhi3011/playwright-automation-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/QA-abhi3011/playwright-automation-framework/issues"
  },
  "homepage": "https://github.com/QA-abhi3011/playwright-automation-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^16.6.1",
    "winston": "^3.19.0"
  }
}
